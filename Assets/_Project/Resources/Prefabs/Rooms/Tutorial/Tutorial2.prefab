    - target: {fileID: 7496542069588654184, guid: 80672fc2e5b8c0146895f86350a41bdf, type: 3}
      propertyPath: m_text
      value: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u044B
        \u0432\u0440\u0435\u0437\u0430\u0435\u043C\u0441\u044F \u0438 \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u043C
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C, \u0442\u0430\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435
        \u0440\u0430\u0441\u043A\u0430\u043B\u044F\u0435\u0442\u0441\u044F \u0433\u0443\u0441\u044C!
        \n\u041F\u0440\u0438 \u0437\u0430\u0436\u0430\u0442\u0438\u0438 \"\u041F\u0440\u043E\u0431\u0435\u043B\",
        \u043C\u043E\u0436\u043D\u043E \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0432\u0435\u0441\u044C \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u043C\u044B\u0439
        \u0443\u0440\u043E\u043D, \u0442\u0440\u0430\u0442\u044F \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u0439
        \u043E\u0433\u043E\u043D\u044C."
      objectReference: {fileID: 0}
    - target: {fileID: 7496542069588654184, guid: 80672fc2e5b8c0146895f86350a41bdf, type: 3}
      propertyPath: m_fontSize
      value: 44
      objectReference: {fileID: 0}
