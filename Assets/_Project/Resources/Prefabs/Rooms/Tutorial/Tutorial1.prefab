    - target: {fileID: 7496542069588654184, guid: 80672fc2e5b8c0146895f86350a41bdf, type: 3}
      propertyPath: m_text
      value: "\u041F\u0440\u0438 \u043D\u0430\u0436\u0430\u0442\u0438\u0438 \u0438
        \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0438 \u043B\u044E\u0431\u043E\u0439
        \u043A\u043D\u043E\u043F\u043A\u0438 \u043C\u044B\u0448\u0438, \u043C\u043E\u0436\u043D\u043E
        \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u0442\u0440\u0430\u0435\u043A\u0442\u043E\u0440\u0438\u044E
        \u0438 \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0443\u044E
        \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0437\u0430\u043F\u0443\u0441\u043A\u0430
        \u0433\u0443\u0441\u044F! \n\n\u0426\u0435\u043B\u044C - \u0437\u0430\u0447\u0438\u0441\u0442\u0438\u0442\u044C
        \u0432\u0441\u0435\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u043D\u0430
        \u0443\u0440\u043E\u0432\u043D\u0435."
      objectReference: {fileID: 0}
